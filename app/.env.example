# Copy this file to .env.local and use a newly issued key.
# Never commit a real API key.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SILICONFLOW_MODEL=qwen-plus

# Creditcoin CC3 Testnet EIP-3009 authorization
# Replace demo addresses with deployed token and settlement contracts before real execution.
CC3_USDC_ADDRESS=0x0000000000000000000000000000000000001001
CC3_USDC_NAME=MockUSDC
CC3_USDC_VERSION=1
CC3_SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000002001
CC3_FUNDER_WALLET_ADDRESS=
PAYMENT_AUTH_DEMO_MODE=true
