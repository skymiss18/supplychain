# Copy this file to .env.local and use a newly issued key.
# Never commit a real API key.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SILICONFLOW_MODEL=qwen-plus

# Attestcoin source transaction on Ethereum Sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_ATTESTATION_SOURCE_ADDRESS=

# Attestcoin proof generation and verification on Creditcoin CC3 Testnet
ATTESTCOIN_SOURCE_CHAIN_KEY=1
ATTESTCOIN_PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network
CC3_AUDIT_PROOF_REGISTRY_ADDRESS=

# Creditcoin CC3 Testnet EIP-3009 authorization
# Set an existing token contract to reuse it, or leave blank to deploy a new MockUSDC.
CC3_USDC_ADDRESS=
CC3_USDC_NAME=MockUSDC
CC3_USDC_VERSION=1
CC3_SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000002001
CC3_FUNDER_WALLET_ADDRESS=
CC3_BUYER_WALLET_ADDRESS=
PAYMENT_AUTH_DEMO_MODE=true
